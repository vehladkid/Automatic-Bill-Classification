# Copy to ~/.config/hrbc/worker.env, chmod 600. Never commit the real file. Secrets may instead be file paths: HRBC_IMAP_PASSWORD_FILE=/path (mode 0600).
HRBC_ENV=prod
HRBC_OUT=/home/tejvir-singh/Desktop/ML-project/outputs
HRBC_INGEST_MAILBOX=expenses@your-company.example
HRBC_INGEST_MAILBOX_ALIASES=
HRBC_INGEST_AUTHSERV_ID=mx.your-company.example      # the authserv-id YOUR receiving server writes in Authentication-Results
HRBC_IMAP_HOST=imap.your-company.example
HRBC_IMAP_USER=expenses@your-company.example
HRBC_IMAP_FOLDER=INBOX
HRBC_IMAP_AUTH=password                              # or xoauth2 (then the HRBC_OAUTH_* variables below)
HRBC_IMAP_PASSWORD_FILE=%h/.config/hrbc/imap_password
# HRBC_OAUTH_TOKEN_URL=https://...  HRBC_OAUTH_CLIENT_ID_FILE=...  HRBC_OAUTH_CLIENT_SECRET_FILE=...  HRBC_OAUTH_REFRESH_TOKEN_FILE=...  HRBC_OAUTH_REFRESH_TOKEN_STORE=%h/.config/hrbc/refresh_token  HRBC_OAUTH_SCOPE=...
HRBC_IMAP_INITIAL=new_only                           # new_only (default: ignore mail already in the folder) | all (ingest everything present once)
HRBC_IMAP_MARK_SEEN=0                                # 0 = mailbox opened read-only; never changed by the worker
# Dedicated TEST mailbox (HRBC_ENV=test): both must equal the configured user/folder, HRBC_OUT must be a separate test directory
# HRBC_TEST_MAILBOX_USER=test-expenses@your-company.example
# HRBC_TEST_FOLDER=HRBC-TEST

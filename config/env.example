# Copy to your shell profile or `set -a; source config/env.example; set +a` before `bash app/run_app.sh`.
# --- Local LLM assist (default OFF) ---
HRBC_LLM_MODE=off                       # off | auto (only when V1 output looks doubtful) | always
HRBC_LLM_URL=http://127.0.0.1:11434     # must be a loopback address (privacy guard in app/llm/config.py)
HRBC_LLM_MODEL=qwen2.5vl:3b             # any vision-capable model served by Ollama; must fit your GPU alongside the other models
HRBC_LLM_USE_IMAGE=1                    # 0 = text-only (OCR lines + boxes), faster, less VRAM
HRBC_LLM_TIMEOUT=180
HRBC_LLM_KEEP_ALIVE=0                   # 0 = unload the model after every request so OCR/Task A/B can use the GPU (6 GB cannot hold both); e.g. 5m keeps it resident (faster, needs ~4.3 GB VRAM free)
HRBC_LLM_MAX_TOKENS=1024                # output cap (stops repetition loops)
HRBC_LLM_CACHE=1                        # reuse results for identical OCR/prompt/model (cache holds model JSON only)
# Remote LLM endpoints are blocked unless BOTH are set (employee documents then leave this machine):
# HRBC_LLM_ALLOW_REMOTE=1
# HRBC_LLM_REMOTE_ACK=I_ACCEPT_THAT_EMPLOYEE_DOCUMENTS_LEAVE_THIS_MACHINE
# --- HR module ---
# HRBC_HR_PIN=change-me                 # optional PIN to enter the HR role (demo only, not real authentication)
# HRBC_OUT=/path/for/outputs            # default: <repo>/outputs (claims DB: outputs/hr/hr.db)

# --- Email ingestion (see deploy/worker.env.example for the full, validated list; credentials ONLY via environment / *_FILE paths; never commit) ---
# HRBC_ENV=prod|test|dev            (prod default; stricter)
# HRBC_INGEST_MAILBOX=              REQUIRED: the expense mailbox address (fail closed when unset)
# HRBC_INGEST_MAILBOX_ALIASES=      optional comma list
# HRBC_INGEST_AUTHSERV_ID=          REQUIRED while HRBC_INGEST_REQUIRE_AUTH=1 (default); REQUIRE_AUTH=0 is refused in prod
# HRBC_IMAP_HOST= HRBC_IMAP_USER= HRBC_IMAP_FOLDER= HRBC_IMAP_AUTH=password|xoauth2 HRBC_IMAP_PASSWORD(_FILE)=
# HRBC_WEBHOOK_SECRET=  HRBC_INGEST_MAX_BYTES=  HRBC_INGEST_MAX_ATTEMPTS=5
